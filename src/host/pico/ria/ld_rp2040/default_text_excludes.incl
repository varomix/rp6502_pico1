/* Pico 1 port: the RP2040 RIA runs from flash. Objects listed here are built
 * without LTO (see ria.cmake RP6502_RIA_RAM_SOURCES) so their names survive
 * to the link, and excluding them from flash .text lands them in RAM via
 * .data's catch-all *(.text*): core 1's 6502 bus loop (runs during flash
 * writes), the audio IRQ and synths, USB host IRQ, VGA backchannel IRQ, and the timer/alarm IRQs. */
*(EXCLUDE_FILE(*libgcc.a: *libc.a: *lib*_a-mem*.o *libm.a: *sys/ria.c.o *sys/vga.c.o *sys/resb.c.o *sys/xram.c.o *aud/mix.c.o *aud/sine.c.o *aud/bel.c.o *aud/bel_presets.c.o *aud/opl.c.o *aud/psg.c.o *emu8950.c.o *hcd_rp2040.c.o *rp2040_usb.c.o *tusb_fifo.c.o *pico_atomic/atomic.c.o *hardware_timer/timer.c.o *pico_time/time.c.o) .text*)
